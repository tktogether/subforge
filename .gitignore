# 构建产物
/dist/
/bin/
*.exe
*.exe~
*.test
*.prof

# 本地数据目录（运行时缓存/输出）
/data/

# 参考二进制（subconverter / mihomo release，用于金测与配置校验）
/tools/

# 日志
*.log

# 设计上下文（impeccable 技能生成，本地专用）
.impeccable.md

# 编辑器与操作系统
.idea/
.vscode/
.DS_Store
Thumbs.db
*.swp

# 工具目录（ZCode 会话状态与本地忽略规则）
.zcode/
.zcodeignore

# Go 构建缓存（本地 -race 调试用）
.gocache/

# 兼容性测试环境临时文件（subconverter 二进制、测试输出）
.compat/bin/
.compat/out/

# Linux binary for test machine
subforge-linux-amd64

# OpenWrt 打包用的预编译二进制（约 40 MB，不属于源码树）
# 打包前由打包者自行交叉编译到该路径，详见 deploy/openwrt/Makefile 的 Build/Prepare
deploy/openwrt/bin/*
!deploy/openwrt/bin/.gitkeep

# 前端构建产物（Vite outDir 直接指向 Go embed 目录）
# 产物是哈希文件名，不入库；只放行占位文件，保证干净 clone 时 go:embed 不会因目录缺失而编译失败
/internal/api/web/dist/*
!/internal/api/web/dist/.gitkeep

# CI 覆盖率产物
coverage.out
# 准层 gobco 产物（condgate 的 gobco 引擎输出，含分片中间文件）
gobco-*

# Wiki 发布脚本的本地缓存（scripts/publish-wiki.ps1 默认把 .wiki.git 克隆到这里）
.wiki-cache/

# 本地临时工作目录（脚本与排查过程的中间产物，不属于项目内容）
/.tmp/
