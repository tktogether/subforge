#!/bin/sh /etc/rc.common
# SubForge init script for OpenWrt

START=99
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/bin/subforge serve
	procd_set_param env SUBFORGE_DATA=/var/lib/subforge
	procd_set_param env SUBFORGE_CONFIG=/etc/subforge
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param respawn
	procd_close_instance
}
